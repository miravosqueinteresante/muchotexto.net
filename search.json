---
layout: null
---
[
  {% for post in site.posts %}
    {
      "title": {{ post.title | jsonify }},
      "url": {{ post.url | relative_url | jsonify }},
      "date": {{ post.date | date_to_string | jsonify }},
      "categories": {{ post.categories | jsonify }},
      "tags": {{ post.tags | jsonify }},
      "type": "articulo",
      "excerpt": {{ post.excerpt | strip_html | truncatewords: 30 | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
  {% assign content_pages = site.pages | where_exp: "p", "p.sitemap != false and p.layout != null and p.title != null" %}
  {% assign exclude_urls = "/buscar/|/404.html|/categories/|/archive/|/tags/" | split: "|" %}
  {% for page in content_pages %}
    {% assign skip = false %}
    {% for ex in exclude_urls %}
      {% if page.url == ex %}{% assign skip = true %}{% endif %}
    {% endfor %}
    {% if skip %}{% continue %}{% endif %}
    ,{
      "title": {{ page.title | jsonify }},
      "url": {{ page.url | relative_url | jsonify }},
      "date": "",
      "categories": [],
      "tags": [],
      "type": "pagina",
      "excerpt": {{ page.content | strip_html | strip_newlines | replace: '  ', ' ' | truncatewords: 50 | jsonify }}
    }
  {% endfor %}
]
